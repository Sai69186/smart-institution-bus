# ── Frontend production environment ──────────────────────────────────────────
# Set these in your Vercel project → Settings → Environment Variables
# DO NOT commit real values here if they contain secrets.

# Backend API URL  (fill in after Render deploys campus-transit-api)
VITE_API_URL=https://campus-transit-api.onrender.com/api

# Backend WebSocket URL  (same host, no /api suffix)
VITE_SOCKET_URL=https://campus-transit-api.onrender.com

# Python AI microservice  (fill in after Render deploys campus-transit-ai)
VITE_PYTHON_URL=https://campus-transit-ai.onrender.com

# Google Maps API key  (only needed if using Google Maps view)
VITE_GOOGLE_MAPS_KEY=AIzaSyB41DRUbKWJHPxaFjMAwdrzWzbVKartNB8
