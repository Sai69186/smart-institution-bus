# ── Frontend production environment ──────────────────────────────────────────
# Set these on your hosting platform (Vercel / Netlify / etc.)
# DO NOT commit real values to version control.

# Your deployed backend URL (Render, Railway, etc.)
VITE_API_URL=https://your-backend.onrender.com/api
VITE_SOCKET_URL=https://your-backend.onrender.com

# Optional: Python AI microservice (if deployed separately)
VITE_PYTHON_URL=https://your-python-service.onrender.com

# Optional: Google Maps API key (only needed if using Google Maps view)
# VITE_GOOGLE_MAPS_KEY=your_production_key_here
