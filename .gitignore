# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment variables — never commit secrets
.env
.env.local
.env.*.local
server/.env

# ML model binaries — too large for git (rf_model.pkl is 300MB+)
# Render trains them at deploy time via build command
python_services/models/*.pkl
python_services/models/*.keras

# Allow example/template env files (safe to commit)
!.env.example
!server/.env.example
# Allow production placeholder (no real secrets)
!.env.production

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
