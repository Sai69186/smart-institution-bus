# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment variables — never commit secrets
.env
.env.local
.env.*.local
server/.env

# ML model binaries — too large for git (rf_model.pkl is 300MB+)
# Render trains them at deploy time via build command
python_services/models/*.pkl
python_services/models/*.keras

# Large training CSV datasets — generated locally, not needed in git
# Render uses institution_bus_dataset.csv (small, already committed) to train
python_services/data/ap_smart_institution_bus_data_100k.csv
python_services/data/ap_bus_dataset_1000stops.csv
python_services/data/institution_bus_dataset_large.csv
python_services/data/institution_bus_dataset_50_buses_realistic.csv

# Allow example/template env files (safe to commit)
!.env.example
!server/.env.example
# Allow production placeholder (no real secrets)
!.env.production

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
